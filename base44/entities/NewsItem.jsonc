{
  "name": "NewsItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "News title"
    },
    "body": {
      "type": "string",
      "description": "News body text"
    },
    "published_date": {
      "type": "string",
      "format": "date",
      "description": "Original publication date for imported news"
    },
    "image_url": {
      "type": "string",
      "description": "Optional image attachment URL"
    },
    "video_url": {
      "type": "string",
      "description": "Optional video attachment URL"
    },
    "author_name": {
      "type": "string",
      "description": "Name of person posting"
    },
    "author_email": {
      "type": "string",
      "description": "Email of person posting"
    }
  },
  "required": [
    "title",
    "body",
    "author_name"
  ]
}