{
  "name": "JobAssignment",
  "type": "object",
  "properties": {
    "job_title": {
      "type": "string",
      "description": "Name of the job"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_to_email": {
      "type": "string"
    },
    "week_label": {
      "type": "string",
      "description": "Weekly assignment key, e.g. 2026-W24; retained for weekly jobs and legacy history"
    },
    "month_label": {
      "type": "string",
      "description": "Monthly assignment key, e.g. 2026-08"
    },
    "assignment_period": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly"
      ],
      "default": "weekly",
      "description": "How long the assignee keeps this job"
    },
    "schedule_days": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday"
        ]
      },
      "description": "Weekdays when this assignment is performed"
    },
    "scheduled_day": {
      "type": "string",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday"
      ],
      "description": "Day scheduled to do the job"
    },
    "days_completed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Weekday names for weekly jobs or ISO dates for monthly jobs that were completed"
    },
    "not_done_days": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Weekday names for weekly jobs or ISO dates for monthly jobs marked not done"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the job has been completed"
    },
    "not_done": {
      "type": "boolean",
      "default": false,
      "description": "Marked as did not do the job"
    },
    "carried_over": {
      "type": "boolean",
      "default": false,
      "description": "This assignment was carried over from its previous weekly or monthly period"
    }
  },
  "required": [
    "job_title",
    "assigned_to_name",
    "assigned_to_email"
  ]
}