{
  "name": "Document",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "default": "Untitled document",
      "description": "Document title"
    },
    "content": {
      "type": "string",
      "description": "Document HTML content"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}